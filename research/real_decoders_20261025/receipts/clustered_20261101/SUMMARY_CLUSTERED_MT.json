  "protocol": {
    "host": "localhost (AMD EPYC 9554, 2x64-core, SMT on); stream core set 128-143",
    "cores_note": "CPUs 128-143 are the SMT siblings of CPUs 0-15 (16 distinct physical cores, all NUMA node 0); measured pure-compute scaling on this set is 14.5x at 16 threads",
    "pin": "nice -n 5 taskset -c 128-143 for every bench (workers are pinned one per CPU of the inherited set); DuckDB 1T pinned to 128",
    "ours": "3 bench runs x 30 queries, each run preceded by a 0.5 s pinned busy loop; median of the 3 bench medians; P95 from the median run; timed region = state clear + parallel scan + merge (row collection/serialization untimed)",
    "parallel_design": "matching rows partitioned into row-balanced run-aligned chunks; each thread accumulates into its own dense per-group state (disjoint, no atomics); partials merged over disjoint group slices; epoch tags make the state self-initialising (no O(G) clearing); memory cap 640 MB of live partials, above which the scan runs in waves merged after each wave",
    "duckdb": "2.0.0, threads set via the connection config, one process per thread count, same SQL/data, forced-aggregation engine SQL",
    "bit_identity": "md5 of the complete JSON result compared across 1/4/8/16 threads",
    "targets": "16-vs-16 vs DuckDB: >=1x at p50, >=3x at p10, no regression vs the 1-thread CLST01 number at p0.1/p1"
  },
